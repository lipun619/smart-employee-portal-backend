{
  "version": "2.0",
  "extensions": {
    "queues": {
      "messageEncoding": "none",
      "visibilityTimeout": "00:00:30",
      "maxDequeueCount": 5,
      "maxPollingInterval": "00:00:10"
    }
  },
  "logging": {
    "logLevel": {
      "default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Azure.Core": "Warning",
      "Azure.Identity": "Warning"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 20
      }
    }
  }
}
